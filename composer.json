{
  "name": "mjs512/voucher-manager",
  "description": "Professional management and distribution of unique voucher codes for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Michael Sczaszny"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "VoucherManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VoucherManager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "php -l voucher-manager.php",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpstan": "phpstan analyse",
    "test": "phpunit",
    "check": [
      "@lint",
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
