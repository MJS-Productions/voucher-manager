{
  "name": "mjs512/voucher-manager",
  "description": "Professional One-Time Code Management for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "MJS-Productions e.U."
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "VoucherManager\\": "src/"
    }
  },
  "scripts": {
    "lint": "php tools/lint-php.php",
    "validate:structure": "php tools/validate-plugin.php",
    "validate:header": "php tools/check-plugin-header.php",
    "test:autoload": "php tools/test-autoload.php",
    "test:extension-api-version": "php tests/Integration/ExtensionApiVersionTest.php",
    "test:extension-distribution-api": "php tests/Integration/ExtensionDistributionApiTest.php",
    "test:extension-pool-read-api": "php tests/Integration/ExtensionPoolReadApiTest.php",
    "test:extension-inventory-read-api": "php tests/Integration/ExtensionInventoryReadApiTest.php",
    "build": "php tools/build-release.php",
    "validate:artifact": "php tools/validate-release.php",
    "quality": [
      "@translations",
      "@lint",
      "@validate:structure",
      "@validate:header",
      "@test:autoload",
      "@test:extension-api-version",
      "@test:extension-distribution-api",
      "@test:extension-pool-read-api",
      "@test:extension-inventory-read-api",
      "@test:golden-path",
      "@test:state-integrity",
      "@test:operational-logging",
      "@test:dashboard-experience",
      "@test:pool-experience",
      "@test:pool-lifecycle-integrity",
      "@test:import-experience",
      "@test:distribution-experience",
      "@test:operational-visibility",
      "@test:sprint7-release-readiness",
      "@test:product-identity",
      "@test:release-identity",
      "@test:inventory-experience",
      "@test:inventory-navigation",
      "@test:settings-foundation",
      "@test:activity-retention",
      "@test:uninstall-boundary",
      "@test:distribution-claim-outcome",
      "@test:distribution-intent-idempotency",
      "@test:distribution-result-delivery",
      "@test:distribution-safety-review",
      "@test:rollback-activity-cleanup",
      "@test:product-language",
      "@test:i18n-readiness",
      "@test:translation-readiness",
      "@test:german-translation",
      "@test:german-language-polish",
      "@test:german-experience-polish",
      "@test:translation-artifact-integrity",
      "@build",
      "@validate:artifact"
    ],
    "test:golden-path": "php tests/Integration/GoldenPathTest.php",
    "test:state-integrity": "php tests/Integration/CodeStateIntegrityTest.php",
    "test:operational-logging": "php tests/Integration/OperationalLoggingTest.php",
    "test:dashboard-experience": "php tests/Integration/DashboardExperienceTest.php",
    "test:pool-experience": "php tests/Integration/PoolExperienceTest.php",
    "test:pool-lifecycle-integrity": "php tests/Integration/PoolLifecycleIntegrityTest.php",
    "test:import-experience": "php tests/Integration/ImportExperienceTest.php",
    "test:distribution-experience": "php tests/Integration/DistributionExperienceTest.php",
    "test:operational-visibility": "php tests/Integration/OperationalVisibilityTest.php",
    "test:sprint6-release-readiness": "php tests/Integration/Sprint6ReleaseReadinessTest.php",
    "test:release-identity": "php tests/Integration/ReleaseIdentityTest.php",
    "test:inventory-experience": "php tests/Integration/InventoryExperienceTest.php",
    "test:inventory-navigation": "php tests/Integration/InventoryNavigationTest.php",
    "test:sprint7-release-readiness": "php tests/Integration/Sprint7ReleaseReadinessTest.php",
    "test:settings-foundation": "php tests/Integration/SettingsFoundationTest.php",
    "test:activity-retention": "php tests/Integration/ActivityRetentionTest.php",
    "test:uninstall-boundary": "php tests/Integration/UninstallBoundaryTest.php",
    "test:distribution-claim-outcome": "php tests/Integration/DistributionClaimOutcomeTest.php",
    "test:distribution-intent-idempotency": "php tests/Integration/DistributionIntentIdempotencyTest.php",
    "test:distribution-result-delivery": "php tests/Integration/DistributionResultDeliveryTest.php",
    "test:distribution-safety-review": "php tests/Integration/DistributionSafetyReviewTest.php",
    "test:rollback-activity-cleanup": "php tests/Integration/RollbackActivityCleanupTest.php",
    "test:product-language": "php tests/Integration/ProductLanguageTest.php",
    "test:i18n-readiness": "php tests/Integration/InternationalizationReadinessTest.php",
    "test:translation-readiness": "php tests/Integration/TranslationReadinessTest.php",
    "test:german-translation": "php tests/Integration/GermanTranslationExperienceTest.php",
    "test:german-language-polish": "php tests/Integration/GermanLanguagePolishTest.php",
    "test:german-experience-polish": "php tests/Integration/GermanExperiencePolishTest.php",
    "translations": "php tools/compile-translations.php",
    "test:translation-artifact-integrity": "php tests/Integration/TranslationArtifactIntegrityTest.php",
    "test:product-identity": "php tests/Integration/ProductIdentityTest.php"
  },
  "config": {
    "sort-packages": true
  }
}
